<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NodePulse.Views.DeviceCodeDialog"
        Title="微软登录"
        Width="520" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1E1C30"
        SystemDecorations="BorderOnly">
    <Border CornerRadius="10" ClipToBounds="True" Background="#1E1C30">
        <StackPanel Margin="24" Spacing="16">

            <TextBlock Text="微软登录" FontSize="20" FontWeight="SemiBold"
                       Foreground="#93B8FF"/>

            <TextBlock Text="浏览器将自动打开登录页面，授权码已复制到剪贴板。"
                       Foreground="#D0D0F0" TextWrapping="Wrap"/>

            <TextBlock Text="验证链接：" Foreground="#A9A9C2" FontSize="13"/>
            <Border Background="#121120" CornerRadius="6" Padding="12">
                <SelectableTextBlock x:Name="LinkText"
                                     Foreground="#73A2F0"
                                     FontSize="13"/>
            </Border>

            <TextBlock Text="授权码：" Foreground="#A9A9C2" FontSize="13"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Background="#121120" CornerRadius="6"
                        Padding="16 10" MinWidth="180">
                    <SelectableTextBlock x:Name="CodeText"
                                         Foreground="#73A2F0"
                                         FontSize="22"
                                         FontWeight="Bold"
                                         LetterSpacing="2"/>
                </Border>
                <Button x:Name="CopyBtn" Content="复制"
                        Width="70" Height="40"
                        Background="{StaticResource BtnGradientBrush}" Foreground="White"
                        CornerRadius="6"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressBar IsIndeterminate="True" Width="20" Height="20"/>
                <TextBlock Text="等待验证..." VerticalAlignment="Center"
                           Foreground="#A9A9C2"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Right" Margin="0 10 0 0">
                <Button x:Name="ReopenBtn" Content="重新打开网页"
                        Width="120" Height="36"
                        Background="{StaticResource BtnGradientBrush}" Foreground="White"
                        CornerRadius="6"/>
                <Button x:Name="CancelBtn" Content="取消"
                        Width="90" Height="36"
                        Background="{StaticResource BtnGradientBrush}" Foreground="White"
                        CornerRadius="6"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>