<UserControl x:Class="NodePulse.Views.CustomDownloadView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="0">

        <TextBlock Grid.Row="0"
                   Text="自定义下载"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0 0 0 20"/>

        <!-- 下载链接：标签 + 输入框 横排 -->
        <Grid Grid.Row="1"
              ColumnDefinitions="80,12,*"
              Margin="0 0 0 14">
            <TextBlock Grid.Column="0"
                       Text="下载链接"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox Grid.Column="2"
                     Text="{Binding Url}"
                     Watermark="https://example.com/file.jar"
                     Height="44"
                     Background="{DynamicResource SurfaceSecondaryBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderSecondaryBrush}"
                     BorderThickness="1"
                     CornerRadius="10"
                     FontSize="14"
                     Padding="16 0"
                     VerticalContentAlignment="Center"/>
        </Grid>

        <!-- 保存位置：标签 + 输入框 + 浏览按钮 横排 -->
        <Grid Grid.Row="2"
              ColumnDefinitions="80,12,*,10,Auto"
              Margin="0 0 0 14">
            <TextBlock Grid.Column="0"
                       Text="保存位置"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox Grid.Column="2"
                     Text="{Binding SaveDirectory}"
                     Watermark="选择保存目录"
                     Height="44"
                     Background="{DynamicResource SurfaceSecondaryBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderSecondaryBrush}"
                     BorderThickness="1"
                     CornerRadius="10"
                     FontSize="13"
                     Padding="16 0"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"/>

            <Button Grid.Column="4"
                    Content="浏览..."
                    Command="{Binding BrowseSaveDirectoryCommand}"
                    Height="44" Width="100"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSecondaryBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    FontSize="13"/>
        </Grid>

        <!-- 文件名：标签 + 输入框 横排 -->
        <Grid Grid.Row="3"
              ColumnDefinitions="80,12,*"
              Margin="0 0 0 14">
            <TextBlock Grid.Column="0"
                       Text="文件名"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox Grid.Column="2"
                     Text="{Binding FileName}"
                     Watermark="例如 my-file.jar"
                     Height="44"
                     Background="{DynamicResource SurfaceSecondaryBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderSecondaryBrush}"
                     BorderThickness="1"
                     CornerRadius="10"
                     FontSize="14"
                     Padding="16 0"
                     VerticalContentAlignment="Center"/>
        </Grid>

        <!-- 进度条 + 状态 -->
        <StackPanel Grid.Row="4" Spacing="8" Margin="0 0 0 16">
            <ProgressBar Value="{Binding Percent}"
                         Minimum="0" Maximum="100"
                         Height="8"
                         Background="{DynamicResource SurfaceSecondaryBrush}"
                         Foreground="{DynamicResource AccentBrush}"
                         CornerRadius="4"
                         IsVisible="{Binding IsDownloading}"/>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <!-- 底部按钮：与输入框左边缘对齐（左边距 = 标签 80 + 间隔 12 = 92） -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="92 0 0 0">
            <Button Content="开始下载"
                    Command="{Binding StartDownloadCommand}"
                    Width="140" Height="44"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    CornerRadius="10"
                    IsEnabled="{Binding !IsDownloading}"/>
            <Button Content="打开文件夹"
                    Command="{Binding OpenFolderCommand}"
                    Width="140" Height="44"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderSecondaryBrush}"
                    BorderThickness="1"
                    FontSize="14"
                    FontWeight="SemiBold"
                    CornerRadius="10"/>
        </StackPanel>
    </Grid>
</UserControl>