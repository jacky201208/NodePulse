c<UserControl x:Class="NodePulse.Views.DownloadView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NodePulse.Views"
             x:Name="DownloadRoot">
    <UserControl.Styles>
        <Style Selector="Button.downloadTab">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="18 8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Margin" Value="2 0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.downloadTab:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.downloadTab:pressed">
            <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
        </Style>
        <Style Selector="Button.downloadTab.selected">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.downloadTab.selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ★ versionCard：变换放在 Button 上，留出上下浮动空间 -->
        <Style Selector="Button.versionCard">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0 2 0 12"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.18"
                                                   Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>
        <Style Selector="Button.versionCard:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransform" Value="translateY(-2px)"/>
        </Style>
        <Style Selector="Button.versionCard:pressed">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>

        <!-- 内层 Border：只负责颜色 / 边框 / 阴影 -->
        <Style Selector="Button.versionCard Border.versionCardBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.versionCard:pointerover Border.versionCardBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BoxShadow" Value="0 5 14 0 #40000000"/>
        </Style>

    </UserControl.Styles>

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfacePrimaryBrush}"
                    CornerRadius="10"
                    Padding="6"
                    Margin="0 0 0 12"
                    BorderBrush="{DynamicResource BorderPrimaryBrush}"
                    BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="downloadTab"
                                        Classes.selected="{Binding IsSelected}"
                                        Content="{Binding DisplayName}"
                                        Command="{Binding $parent[UserControl].DataContext.SelectTabCommand}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Panel Grid.Row="1">
                <Grid IsVisible="{Binding IsInstanceTab}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,8,120,8,68"
                          Margin="0 0 0 16">

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText}"
                                 Watermark="输入版本名称进行搜索"
                                 Height="40"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource SurfaceSecondaryBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderSecondaryBrush}"
                                 BorderThickness="1"
                                 CornerRadius="8"
                                 FontSize="13"
                                 Padding="14 0"
                                 HorizontalAlignment="Stretch"/>

                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding VersionTypeList}"
                                  SelectedItem="{Binding SelectedVersionType}"
                                  Height="40"
                                  Background="{DynamicResource SurfaceSecondaryBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderSecondaryBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  FontSize="13"
                                  VerticalContentAlignment="Center"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"/>

                        <Button Grid.Column="4"
                                Classes="toolBtn"
                                Content="刷新"
                                Command="{Binding RefreshListCommand}"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ★ 给 ScrollViewer 加一点上 padding，让第一张卡 hover 时不会贴边被裁 -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0 4 0 0">
                        <ItemsControl ItemsSource="{Binding VersionList}"
                                      ClipToBounds="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="versionCard"
                                            Command="{Binding $parent[UserControl].DataContext.StartConfiguringCommand}"
                                            CommandParameter="{Binding}">
                                        <Border Classes="versionCardBorder"
                                                Background="{DynamicResource SurfaceSecondaryBrush}"
                                                CornerRadius="10"
                                                Padding="20 16"
                                                BorderThickness="1">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock Text="{Binding Id}"
                                                                   FontSize="17"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Border CornerRadius="6"
                                                                Padding="8 2"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding TypeBadgeColor}">
                                                            <TextBlock Text="{Binding TypeBadgeText}"
                                                                       FontSize="11"
                                                                       Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayTime}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="→"
                                                           FontSize="20"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            CornerRadius="8"
                            Padding="14 10"
                            Margin="0 12 0 0"
                            BorderBrush="{DynamicResource BorderSecondaryBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>

                <ContentControl x:Name="TabContentHost"
                                IsVisible="{Binding !IsInstanceTab}"/>
            </Panel>
        </Grid>

        <Panel IsVisible="{Binding IsConfiguring}">
            <views:VersionConfigView DataContext="{Binding Config}"/>
        </Panel>
    </Grid>
</UserControl>