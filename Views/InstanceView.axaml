<UserControl x:Class="NodePulse.Views.InstanceView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NodePulse.Controls">
    <UserControl.Styles>
        <Style Selector="Button.toolBtn">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.toolBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="Button.toolBtn:pressed">
            <Setter Property="Background" Value="#3A80D2"/>
        </Style>

        <Style Selector="Button.cardAction">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.cardAction.settings">
            <Setter Property="Background" Value="#8A6FB0"/>
        </Style>
        <Style Selector="Button.cardAction.settings:pointerover">
            <Setter Property="Background" Value="#9B7FC0"/>
        </Style>
        <Style Selector="Button.cardAction.launch">
            <Setter Property="Background" Value="{DynamicResource ButtonSuccessBrush}"/>
        </Style>
        <Style Selector="Button.cardAction.launch:pointerover">
            <Setter Property="Background" Value="{DynamicResource ButtonSuccessDarkBrush}"/>
        </Style>
        <Style Selector="Button.cardAction.delete">
            <Setter Property="Background" Value="{DynamicResource ButtonDangerBrush}"/>
        </Style>
        <Style Selector="Button.cardAction.delete:pointerover">
            <Setter Property="Background" Value="#B84455"/>
        </Style>

        <!-- ★ instanceCard：Border 是 DataTemplate 根，变换安全，保留 -->
        <Style Selector="Border.instanceCard">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.18"
                                                   Easing="CubicEaseOut"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
        </Style>
        <Style Selector="Border.instanceCard:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-3px)"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BoxShadow" Value="0 6 16 0 #40000000"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource OverlayBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12"
                    Margin="24 24 24 16">
            <TextBlock Text="实例管理" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
            <Button Classes="toolBtn"
                    Content="刷新"
                    Command="{Binding RefreshCommand}"
                    Width="80"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Padding="0 4 0 0"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Instances}"
                          Margin="24 0 24 24"
                          ClipToBounds="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="instanceCard"
                                Background="{DynamicResource SurfacePrimaryBrush}"
                                CornerRadius="8"
                                Padding="16" Margin="0 0 0 10"
                                BorderBrush="{DynamicResource BorderPrimaryBrush}"
                                BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <Border Width="{Binding BoxSize}"
                                        Height="{Binding BoxSize}"
                                        CornerRadius="8"
                                        Background="{DynamicResource InstanceIconBoxBrush}"
                                        Margin="0 0 12 0"
                                        VerticalAlignment="Center"
                                        ClipToBounds="True">

                                    <Border Width="{Binding IconSize}"
                                            Height="{Binding IconSize}"
                                            CornerRadius="6"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Image Source="{Binding IconBitmap}"
                                               Stretch="UniformToFill"/>
                                    </Border>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="18"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DisplayText}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Classes="cardAction settings"
                                        Command="{Binding $parent[UserControl].DataContext.OpenSettingsCommand}"
                                        CommandParameter="{Binding}"
                                        Width="78" Margin="0 0 8 0"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <controls:EmojiIcon IconSource="avares://NodePulse/Assets/Icons/Emoji/gear.png"
                                                            IconSize="14"
                                                            VerticalAlignment="Center"/>
                                        <TextBlock Text="设置"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="3"
                                        Classes="cardAction launch"
                                        Content="启动"
                                        Command="{Binding $parent[UserControl].DataContext.LaunchInstanceCommand}"
                                        CommandParameter="{Binding}"
                                        Width="64" Margin="0 0 8 0"
                                        VerticalAlignment="Center"/>

                                <Button Grid.Column="4"
                                        Classes="cardAction delete"
                                        Content="删除"
                                        Command="{Binding $parent[UserControl].DataContext.DeleteInstanceCommand}"
                                        CommandParameter="{Binding}"
                                        Width="64"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>