<UserControl x:Class="NodePulse.Views.InstanceView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:NodePulse.Controls">
    <UserControl.Styles>
        <Style Selector="Button.cardAction">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#4A90E2" Offset="0"/>
                    <GradientStop Color="#22D3EE" Offset="1"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.cardAction:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#5AA0F2" Offset="0"/>
                    <GradientStop Color="#3EE4FF" Offset="1"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Border.instanceCard">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.instanceCard:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-3px)"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Button.sideTabItem">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.sideTabItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        </Style>

        <Style Selector="Button.folderTab">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.folderTab:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Button.folderListItem">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.folderListItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource OverlayBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧 tab 栏 -->
        <Border Grid.Column="0" Margin="16 16 0 16"
                Background="{DynamicResource SurfacePrimaryBrush}"
                CornerRadius="12" BorderBrush="{DynamicResource BorderPrimaryBrush}"
                BorderThickness="1" Padding="12">
            <StackPanel Spacing="10">
                <TextBlock Text="实例" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="8 4"/>
                <TextBlock Text="Minecraft 文件夹" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="8 6 8 0"/>
                <ItemsControl ItemsSource="{Binding MinecraftFolders}"
                              HorizontalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="folderListItem"
                                    Command="{Binding $parent[ItemsControl].DataContext.SwitchFolderCommand}"
                                    CommandParameter="{Binding Path}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Padding="10 8">
                                <Grid ColumnDefinitions="3,*" VerticalAlignment="Center">
                                    <Border Width="3" Height="24" CornerRadius="2"
                                            Background="{DynamicResource AccentBrush}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            IsVisible="{Binding IsCurrent}"/>
                                    <StackPanel Grid.Column="1" Margin="10 0 0 0"
                                                Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Path}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0 6"/>
                <Button Classes="sideTabItem" Command="{Binding ImportFolderCommand}"
                        HorizontalContentAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="＋" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="导入 Minecraft 文件夹" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
                <Button Classes="sideTabItem" Command="{Binding ImportPackCommand}"
                        HorizontalContentAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="＋" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="导入整合包" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 右侧内容区 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="24 24 24 16">
                <TextBlock Text="实例管理" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Button Classes="toolBtn" Content="刷新"
                        Command="{Binding RefreshCommand}" Width="80" Height="32"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" Padding="0 4 0 0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Instances}" Margin="24 20 24 24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="instanceCard"
                                    Background="{DynamicResource SurfacePrimaryBrush}"
                                    CornerRadius="8" Padding="16" Margin="0 6 0 10"
                                    BorderBrush="{DynamicResource BorderPrimaryBrush}"
                                    BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                    <Border Width="{Binding BoxSize}" Height="{Binding BoxSize}"
                                            CornerRadius="8"
                                            Background="{DynamicResource InstanceIconBoxBrush}"
                                            Margin="0 0 12 0">
                                        <Border Width="{Binding IconSize}" Height="{Binding IconSize}"
                                                CornerRadius="6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding IconBitmap}" Stretch="UniformToFill"/>
                                        </Border>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                        <TextBlock Text="{Binding Name}" FontSize="18"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding DisplayText}" FontSize="12"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Classes="cardAction settings" Content="设置"
                                                Command="{Binding $parent[UserControl].DataContext.OpenSettingsCommand}"
                                                CommandParameter="{Binding}" Width="70"/>
                                        <Button Classes="cardAction launch" Content="启动"
                                                Command="{Binding $parent[UserControl].DataContext.LaunchInstanceCommand}"
                                                CommandParameter="{Binding}" Width="60"/>
                                        <Button Classes="cardAction delete" Content="删除"
                                                Command="{Binding $parent[UserControl].DataContext.DeleteInstanceCommand}"
                                                CommandParameter="{Binding}" Width="60"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>