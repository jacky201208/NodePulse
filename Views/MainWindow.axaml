<Window x:Class="NodePulse.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NodePulse.Views"
        xmlns:vm="clr-namespace:NodePulse.ViewModels"
        xmlns:controls="clr-namespace:NodePulse.Controls"
        Title="NodePulse 启动器"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="600"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaChromeHints="NoChrome">
    <Window.Styles>
        <!-- ============================================================ -->
        <!-- 全局过渡                                                      -->
        <!-- ============================================================ -->

        <Style Selector="Button">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Border">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- 页面切换过渡 -->
        <Style Selector="ContentControl#MainContent">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.28"
                                      Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.32"
                                                   Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- ============================================================ -->
        <!-- 侧边栏导航按钮                                                -->
        <!-- ============================================================ -->

        <Style Selector="Button.navBtn">
            <Setter Property="Height" Value="52"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16 0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.navBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        </Style>
        <Style Selector="Button.navBtn:pressed">
            <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}"/>
        </Style>
        <Style Selector="Button.navBtn TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style Selector="Button.navBtn Border.iconMask">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============================================================ -->
        <!-- 标题栏按钮                                                    -->
        <!-- ============================================================ -->

        <Style Selector="Button.titleBtn">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.titleBtn Path">
            <Setter Property="Stroke" Value="{DynamicResource TitleBarForegroundBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.titleBtn#BtnMin:pointerover">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="Button.titleBtn#BtnMin:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource TitleBarForegroundBrush}"/>
        </Style>
        <Style Selector="Button.titleBtn#BtnClose:pointerover">
            <Setter Property="Background" Value="#D64860"/>
        </Style>
        <Style Selector="Button.titleBtn#BtnClose:pointerover Path">
            <Setter Property="Stroke" Value="White"/>
        </Style>

        <!-- ============================================================ -->
        <!-- 下载任务按钮（外观已由全局取消按钮 cancelJobBtn 统一提供）       -->
        <!-- ============================================================ -->

        <Style Selector="Button.expandBtn">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.expandBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        </Style>
        <Style Selector="Button.expandBtn Path">
            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="12"
            ClipToBounds="True"
            Background="{DynamicResource AppWindowBackgroundBrush}"
            BoxShadow="0 8 24 0 #60000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    CornerRadius="12,12,0,0"
                    x:Name="TitleBarDragArea">
                <Grid Margin="14 0">
                    <TextBlock Text="NodePulse 启动器"
                               Foreground="{DynamicResource TitleBarForegroundBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="6">
                        <Button x:Name="BtnMin" Classes="titleBtn">
                            <Path Data="M0,0 L12,0"/>
                        </Button>
                        <Button x:Name="BtnClose" Classes="titleBtn">
                            <Path Data="M0,0 L11,11 M11,0 L0,11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 侧边栏 ============ -->
            <Border Grid.Row="1" Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    CornerRadius="0,0,0,12"
                    Padding="10">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 顶部：主要功能 -->
                    <StackPanel Grid.Row="0" Spacing="6">
                        <TextBlock Text="NodePulse" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextLinkBrush}"
                                   Margin="8 12 0 0"/>
                        <Separator Margin="4 8" Background="{DynamicResource SeparatorBrush}"/>

                        <Button x:Name="NavLaunch" Classes="navBtn">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="iconMask">
                                    <Border.OpacityMask>
                                        <ImageBrush Source="avares://NodePulse/Assets/Icons/launch.png"
                                                    Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                                <TextBlock Text="启动"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavInstance" Classes="navBtn">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="iconMask">
                                    <Border.OpacityMask>
                                        <ImageBrush Source="avares://NodePulse/Assets/Icons/instance.png"
                                                    Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                                <TextBlock Text="实例"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavDownload" Classes="navBtn">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="iconMask">
                                    <Border.OpacityMask>
                                        <ImageBrush Source="avares://NodePulse/Assets/Icons/download.png"
                                                    Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                                <TextBlock Text="下载"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavMultiplayer" Classes="navBtn">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="iconMask">
                                    <Border.OpacityMask>
                                        <ImageBrush Source="avares://NodePulse/Assets/Icons/multiplayer.png"
                                                    Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                                <TextBlock Text="联机"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavAccount" Classes="navBtn">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="iconMask">
                                    <Border.OpacityMask>
                                        <ImageBrush Source="avares://NodePulse/Assets/Icons/account.png"
                                                    Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                                <TextBlock Text="账户"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavGlobalSettings" Classes="navBtn">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="iconMask">
                                    <Border.OpacityMask>
                                        <ImageBrush Source="avares://NodePulse/Assets/Icons/settings.png"
                                                    Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                                <TextBlock Text="设置"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 底部：关于 -->
                    <StackPanel Grid.Row="2" Spacing="6">
                        <Separator Margin="4 8" Background="{DynamicResource SeparatorBrush}"/>

                        <Button x:Name="NavAbout" Classes="navBtn">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Classes="iconMask">
                                    <Border.OpacityMask>
                                        <ImageBrush Source="avares://NodePulse/Assets/Icons/about.png"
                                                    Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                                <TextBlock Text="关于"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 主内容区 ============ -->
            <Grid Grid.Row="1" Grid.Column="1"
                  Background="{DynamicResource AppWindowBackgroundBrush}"
                  ClipToBounds="True">
                <ContentControl x:Name="MainContent" Margin="18"/>

                <Border x:Name="FloatingProgressBtn"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0 0 16 16"
                        Width="52" Height="52"
                        CornerRadius="26"
                        Background="{DynamicResource AccentBrush}"
                        IsVisible="{Binding ShowFloatingButton}"
                        BoxShadow="0 4 12 0 #50000000"
                        Cursor="Hand"
                        PointerPressed="OnFloatingButtonPressed">
                    <Grid>
                        <Path Data="M 10,3 L 10,17 M 4,12 L 10,17 L 16,12 M 5,19 L 15,19"
                              Stroke="{DynamicResource TextOnAccentBrush}"
                              StrokeThickness="1.8"
                              StrokeLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsVisible="{Binding !HasActiveJobs}"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Spacing="0" IsVisible="{Binding HasActiveJobs}">
                            <TextBlock Text="{Binding OverallPercent, StringFormat={}{0:F0}}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnAccentBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="%"
                                       FontSize="9"
                                       Foreground="{DynamicResource TextOnAccentBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0 -2 0 0"/>
                        </StackPanel>

                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0 1 1 0"
                                MinWidth="16" Height="16"
                                CornerRadius="8"
                                Background="#E74C3C"
                                IsVisible="{Binding HasActiveJobs}">
                            <TextBlock Text="{Binding ActiveJobCount}"
                                       FontSize="9" FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="4 0"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============ 下载管理面板（全屏覆盖） ============ -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource OverlayBackgroundBrush}"
                    CornerRadius="0,0,12,12"
                    IsVisible="{Binding IsPanelOpen}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            Padding="16 12">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                            <Button Classes="backCircleBtn"
                                    Command="{Binding ClosePanelCommand}">
                                <Border Width="20" Height="20"
                                        Background="White">
                                    <Border.OpacityMask>
                                        <ImageBrush Source="avares://NodePulse/Assets/Icons/back.png"
                                                    Stretch="Uniform"/>
                                    </Border.OpacityMask>
                                </Border>
                            </Button>

                            <TextBlock Grid.Column="1"
                                       Text="下载管理" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextLinkBrush}"
                                       VerticalAlignment="Center"
                                       Margin="16 0"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding JobSearchText}"
                                     Watermark="搜索下载任务..."
                                     Width="220" Height="32"
                                     Background="{DynamicResource TextBoxBackgroundBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderSecondaryBrush}"
                                     CornerRadius="4"
                                     VerticalAlignment="Center"/>
                            <Button Grid.Column="3"
                                    Content="刷新"
                                    Command="{Binding RefreshCommand}"
                                    Height="32" Margin="8 0 0 0"
                                    Background="{StaticResource BtnGradientBrush}"
                                    Foreground="White"
                                    CornerRadius="4"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Margin="16">
                        <ItemsControl ItemsSource="{Binding FilteredJobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfacePrimaryBrush}"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0 0 0 12"
                                            BorderBrush="{DynamicResource BorderPrimaryBrush}"
                                            BorderThickness="1">
                                        <Grid RowDefinitions="Auto,Auto">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                                                <Border Width="48" Height="48"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource InstanceIconBoxBrush}"
                                                        Margin="0 0 12 0"
                                                        VerticalAlignment="Center"
                                                        ClipToBounds="True">
                                                    <Border Width="{Binding IconSize}"
                                                            Height="{Binding IconSize}"
                                                            CornerRadius="6"
                                                            ClipToBounds="True"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Image Source="{Binding IconBitmap}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                                                CornerRadius="3"
                                                                Padding="6 1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding VersionType}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Ellipse Width="8" Height="8"
                                                                 Fill="{Binding StateColor}"
                                                                 VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Stage}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="8"
                                                            VerticalAlignment="Center"
                                                            Margin="12 0">
                                                    <Ellipse Width="10" Height="10"
                                                             Fill="{Binding StateColor}"
                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TotalPercent, StringFormat={}{0:F0}%}"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               MinWidth="36"/>
                                                </StackPanel>

                                                <Button Grid.Column="3"
                                                        Classes="expandBtn"
                                                        Command="{Binding $parent[Window].DataContext.ToggleExpandCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="M 0,0 L 6,6 L 12,0"
                                                          Width="12" Height="7"
                                                          Stretch="None"/>
                                                </Button>
                                            </Grid>

                                            <StackPanel Grid.Row="1"
                                                        Spacing="12"
                                                        Margin="0 14 0 0"
                                                        IsVisible="{Binding IsExpanded}">

                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="总进度"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="12"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TotalPercent, StringFormat={}{0:F1}%}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontWeight="SemiBold"/>
                                                    </Grid>
                                                    <ProgressBar Value="{Binding TotalPercent}"
                                                                 Height="6"
                                                                 Background="{DynamicResource SurfaceSecondaryBrush}"
                                                                 Foreground="{DynamicResource ButtonSuccessBrush}"/>
                                                </StackPanel>

                                                <Border Background="{DynamicResource TextBoxBackgroundBrush}"
                                                        CornerRadius="6"
                                                        Padding="14 12"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto,*"
                                                          RowDefinitions="Auto,Auto,Auto">

                                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                                   Text="下载速度"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="12"
                                                                   Width="72"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                                   Text="{Binding SpeedText}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                                   Text="当前阶段"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="12"
                                                                   Margin="0 8 0 0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                                   Text="{Binding Stage}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="12"
                                                                   Margin="0 8 0 0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                                   Text="剩余文件"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="12"
                                                                   Margin="0 8 0 0"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Row="2" Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    Margin="0 8 0 0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FilesRemainingAllText}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding FilesDoneAll, StringFormat={}(已完成 {0}}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       FontSize="11"/>
                                                            <TextBlock Text="{Binding FilesTotalAll, StringFormat={}/ {0})}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       FontSize="11"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Button Classes="cancelJobBtn"
                                                        Content="取消"
                                                        Command="{Binding $parent[Window].DataContext.CancelJobCommand}"
                                                        CommandParameter="{Binding}"
                                                        IsVisible="{Binding ShowCancel}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1"
                               Text="暂无下载任务"
                               FontSize="14"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !HasJobs}"/>
                </Grid>
            </Border>

            <!-- ============ Toast 提示 ============ -->
            <Border x:Name="ToastHost"
                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="24 0 0 24"
                    Background="{DynamicResource ToastBackgroundBrush}"
                    BorderBrush="{DynamicResource ToastBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16 12"
                    Opacity="0"
                    RenderTransform="translateY(20px)"
                    IsHitTestVisible="False"
                    BoxShadow="0 4 16 0 #80000000">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                        <TransformOperationsTransition Property="RenderTransform"
                                                       Duration="0:0:0.25"
                                                       Easing="CubicEaseOut"/>
                    </Transitions>
                </Border.Transitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:EmojiIcon IconSource="avares://NodePulse/Assets/Icons/Emoji/success.png"
                                        IconSize="20"
                                        VerticalAlignment="Center"/>
                    <TextBlock x:Name="ToastText"
                               Text=""
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>